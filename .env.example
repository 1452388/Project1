# 活码管理系统 - 环境变量配置
# 复制此文件为 .env 并根据需要修改

# ─── 站点 ───
# 扫码跳转时生成的二维码内容前缀
# BASE_URL=https://www.hxy820.uno
BASE_URL=http://localhost:8000

# ─── 数据库 ───
# 本地开发默认 SQLite，无需配置
# 生产环境（腾讯云 MySQL）：
# DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/livecode_db

# ─── 调试模式 ───
DEBUG=true

# ─── 密钥 ───
# 生产环境请改为随机字符串
# SECRET_KEY=your-secret-key-here