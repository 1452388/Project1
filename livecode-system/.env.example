# 活码管理系统 - 环境变量配置
# 复制此文件为 .env 并根据需要修改

# ─── 站点 ───
# 扫码跳转时生成的二维码内容前缀
# BASE_URL=https://www.hxy820.uno
BASE_URL=https://www.hxy820.uno

# ─── 数据库 ───
# 本地开发默认 SQLite，无需配置
# 生产环境必须使用 PostgreSQL（Neon / Supabase 等）
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/livecode_db

# ─── 调试模式 ───
DEBUG=true

# ─── 存储后端 ───
# local = 本地文件系统（默认）
# r2 = Cloudflare R2（Vercel 部署推荐）
# STORAGE_BACKEND=local

# ─── Cloudflare R2（STORAGE_BACKEND=r2 时必填）───
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_URL=https://cdn.your-domain.com